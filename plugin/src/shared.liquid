                open0: p.open0, open1: p.open1,
                // and where a long tie stops, so every line in it can be
                // ticked there
                to: p.to, ends: p.ends || null, todo: !!p.todo,
                c0: Math.min.apply(null, cs), c1: Math.max.apply(null, cs),
                joins: bd ? bd.moves.map(function (m) {
